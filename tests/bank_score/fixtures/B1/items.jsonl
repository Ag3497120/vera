{"id":"b1s-001","lang":"ja","category":"基本の格","phenomenon":"が・を・で の基本格","difficulty":1,"input":"ミナトさんが図書館で本を借りた。","expect":{"readable":true,"clauses":[{"predicate":"借りる","roles":{"agent":"ミナトさん","patient":"本","place":"図書館"},"polarity":"+","tense":"past","modality":null}],"relations":[],"must_not":[{"role":"agent","value":"図書館"},{"role":"patient","value":"図書館"}]},"rationale":"借りたのはミナトさん、借りられたのは本、場所は図書館。"}
{"id":"b1s-002","lang":"ja","category":"基本の格","phenomenon":"に格の受け手","difficulty":1,"input":"先生が生徒に地図を渡した。","expect":{"readable":true,"clauses":[{"predicate":"渡す","roles":{"agent":"先生","recipient":"生徒","patient":"地図"},"polarity":"+","tense":"past","modality":null}],"relations":[],"must_not":[{"role":"recipient","value":"地図"},{"role":"agent","value":"生徒"}]},"rationale":"渡す側が先生、受け手が生徒、渡されるのが地図。"}
