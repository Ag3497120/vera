{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vera events add owner_utterance --stdin --from claude-code --ledger-dir \"${CLAUDE_PROJECT_DIR:-.}/.vera/ledger\" || exit 1",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "vera events add auto --stdin --from claude-code --ledger-dir \"${CLAUDE_PROJECT_DIR:-.}/.vera/ledger\" || exit 1",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vera events add agent_stop --stdin --from claude-code --ledger-dir \"${CLAUDE_PROJECT_DIR:-.}/.vera/ledger\" || exit 1",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vera events add agent_stop --stdin --from claude-code --ledger-dir \"${CLAUDE_PROJECT_DIR:-.}/.vera/ledger\" || exit 1",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vera events add auto --stdin --from claude-code --ledger-dir \"${CLAUDE_PROJECT_DIR:-.}/.vera/ledger\" || exit 1",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vera events add auto --stdin --from claude-code --ledger-dir \"${CLAUDE_PROJECT_DIR:-.}/.vera/ledger\" || exit 1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
